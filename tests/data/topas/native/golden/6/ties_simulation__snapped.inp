' Generated by PowderLine from a topas.rietveld recipe (topas engine schema 0.1.0, TOPAS 6)
iters 0
chi2_convergence_criteria 0.001

' instrument peak type: TCHZ_Peak_Type
prm !inst_U 0.01037914
prm !inst_V 0.0003329
prm !inst_W 0.00063604
prm !inst_Z 0
prm !inst_X 1e-05
prm !inst_Y 0.0028143
prm !lp_monochromator_angle 90

xdd "ties_simulation__snapped.xye" xye_format
   x_calculation_step 0.001
   start_X 1.000355998
   finish_X 14.99760389
   lam ymin_on_ymax 0.0001 la !lam_la 1 lo !lam_lo 0.1665 lh !lam_lh 0.0001
   bkg !bkg 10 5 1
   str
      phase_name "hexA"
      space_group "p63/mmc"
      scale !p1_scale 1e-06
      a !p1_cell_a 3.2   b = Get(a);   c !p1_cell_c 5.2   al 90   be 90   ga 120
      prm p1_volume = Get(cell_volume); : 0
      site A x = 1/3; y = 2/3; z 0.25 occ Zn !p1_a1_occ 1 u11 !p1_a1_u11 0.01 u22 = p1_a1_u11; u33 !p1_a1_u33 0.012 u12 = p1_a1_u11/2; u13 0 u23 0
      site B x !p1_a2_x 0.17 y = 2*p1_a2_x; z 0.25 occ Mg !p1_a2_occ 1 u11 !p1_a2_u11 0.008 u22 !p1_a2_u22 0.01 u33 !p1_a2_u33 0.009 u12 = p1_a2_u22/2; u13 0 u23 0
      TCHZ_Peak_Type(, inst_U, , inst_V, , inst_W, , inst_Z, , inst_X, , inst_Y)
      LP_Factor(, lp_monochromator_angle)
      phase_out "ties_simulation__snapped_p1_peaks.txt" load out_record out_fmt out_eqn
      {
         " %.0f" = H;
         " %.0f" = K;
         " %.0f" = L;
         " %.0f" = M;
         " %.10g" = D_spacing;
         " %.10g" = 2 Rad Th;
         " %.10g" = I_no_scale_pks;
         " %.10g" = I_after_scale_pks;
         " %.10g" = Iobs_no_scale_pks;
         " %.10g" = A01;
         " %.10g" = B01;
         " %.10g" = A11;
         " %.10g\n" = B11;
      }
   str
      phase_name "tetA"
      space_group "p4/mbm"
      scale !p2_scale 1e-06
      a !p2_cell_a 6   b = Get(a);   c !p2_cell_c 3.1   al 90   be 90   ga 90
      prm p2_volume = Get(cell_volume); : 0
      site C x !p2_a1_x 0.18 y = p2_a1_x + 1/2; z 0 occ Fe !p2_a1_occ 1 beq !p2_a1_beq 0.4
      TCHZ_Peak_Type(, inst_U, , inst_V, , inst_W, , inst_Z, , inst_X, , inst_Y)
      LP_Factor(, lp_monochromator_angle)
      phase_out "ties_simulation__snapped_p2_peaks.txt" load out_record out_fmt out_eqn
      {
         " %.0f" = H;
         " %.0f" = K;
         " %.0f" = L;
         " %.0f" = M;
         " %.10g" = D_spacing;
         " %.10g" = 2 Rad Th;
         " %.10g" = I_no_scale_pks;
         " %.10g" = I_after_scale_pks;
         " %.10g" = Iobs_no_scale_pks;
         " %.10g" = A01;
         " %.10g" = B01;
         " %.10g" = A11;
         " %.10g\n" = B11;
      }

xdd_out "ties_simulation__snapped_profile.txt" load out_record out_fmt out_eqn
{
   " %.10g" = X;
   " %.10g" = Yobs;
   " %.10g\n" = Ycalc;
}

out "ties_simulation__snapped_results.csv"
   out_record out_fmt "parameter,value,esd\n"
   out_record out_eqn = Get(r_wp); out_fmt "r_wp,%.12g,\n"
   out_record out_eqn = Get(r_exp); out_fmt "r_exp,%.12g,\n"
   out_record out_eqn = Get(gof); out_fmt "gof,%.12g,\n"
   out_record out_eqn = Get(number_independent_parameters); out_fmt "number_independent_parameters,%.12g,\n"
   out_record out_eqn = p1_volume; out_fmt "p1_volume,%.12g,\n"
   out_record out_eqn = p2_volume; out_fmt "p2_volume,%.12g,\n"
