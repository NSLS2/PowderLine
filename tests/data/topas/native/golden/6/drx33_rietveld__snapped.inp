' Generated by PowderLine from a topas.rietveld recipe (topas engine schema 0.1.0, TOPAS 6)
iters 1000
do_errors
chi2_convergence_criteria 0.001

' instrument peak type: TCHZ_Peak_Type
prm !inst_U 0.01037914
prm !inst_V 0.0003329
prm !inst_W 0.00063604
prm !inst_Z 0
prm !inst_X 1e-05
prm !inst_Y 0.0028143
prm !lp_monochromator_angle 90

xdd "drx33_rietveld__snapped.xye" xye_format
   x_calculation_step 0.001
   start_X 1.000356
   finish_X 14.99760389
   lam ymin_on_ymax 0.0001 la !lam_la 1 lo !lam_lo 0.1665 lh !lam_lh 0.0001
   bkg bkg 66.578154 -4.7863857 -0.58395094 2.204868 -1.6575423 2.2488879
   str
      phase_name "DRX_33"
      space_group "fm-3m"
      scale p1_scale 7.6251534e-07
      a p1_cell_a 4.1826535   b = Get(a);   c = Get(a);   al 90   be 90   ga 90
      prm p1_volume = Get(cell_volume); : 0
      site Li x 0 y 0 z 0 occ Li !p1_a1_occ 0.6 beq !p1_a1_beq 0.4026798596
      site Mg x 0 y 0 z 0 occ Mg !p1_a2_occ 0.1 beq !p1_a2_beq 0.4026798596
      site Mn1 x 0 y 0 z 0 occ Mn !p1_a3_occ 0.2 beq !p1_a3_beq 0.4026798596
      site O1 x 0.5 y 0.5 z 0.5 occ O !p1_a4_occ 1 beq !p1_a4_beq 0.773776985
      site W x 0 y 0 z 0 occ W !p1_a5_occ 0.1 beq !p1_a5_beq 0.4026798596
      TCHZ_Peak_Type(, inst_U, , inst_V, , inst_W, , inst_Z, , inst_X, , inst_Y)
      prm p1_strain_l 0.288493 min 0.0001 max 5
      Strain_L(, p1_strain_l)
      prm p1_strain_g 0.673496 min 0.0001 max 5
      Strain_G(, p1_strain_g)
      prm p1_e0 = Voigt_FWHM_GL(p1_strain_g, p1_strain_l) .25 Pi/360; : 0
      LP_Factor(, lp_monochromator_angle)
      phase_out "drx33_rietveld__snapped_p1_peaks.txt" load out_record out_fmt out_eqn
      {
         " %.0f" = H;
         " %.0f" = K;
         " %.0f" = L;
         " %.0f" = M;
         " %.10g" = D_spacing;
         " %.10g" = 2 Rad Th;
         " %.10g" = I_no_scale_pks;
         " %.10g" = I_after_scale_pks;
         " %.10g" = Iobs_no_scale_pks;
         " %.10g" = A01;
         " %.10g" = B01;
         " %.10g" = A11;
         " %.10g\n" = B11;
      }
   str
      phase_name "Li4MgWO6_SG12"
      space_group "c12/m1"
      scale p2_scale 1.6876462e-07
      a p2_cell_a 5.1331227   b p2_cell_b 8.7878053   c p2_cell_c 5.1045813   al 90   be p2_cell_beta 110.82135   ga 90
      prm p2_volume = Get(cell_volume); : 0
      site Li1 x 0 y !p2_a1_y 0.33 z 0.5 occ Li !p2_a1_occ 1 beq !p2_a1_beq 0
      site Li2 x 0 y !p2_a2_y 0.167 z 0 occ Li !p2_a2_occ 0.5 beq !p2_a2_beq 0
      site Li3 x 0 y 0 z 0.5 occ Li !p2_a3_occ 1 beq !p2_a3_beq 0
      site Mg x 0 y !p2_a4_y 0.167 z 0 occ Mg !p2_a4_occ 0.5 beq !p2_a4_beq 0
      site O1 x !p2_a5_x 0.238 y !p2_a5_y 0.343 z !p2_a5_z 0.234 occ O !p2_a5_occ 1 beq !p2_a5_beq 0
      site O2 x !p2_a6_x 0.259 y 0 z !p2_a6_z 0.226 occ O !p2_a6_occ 1 beq !p2_a6_beq 0
      site W x 0 y 0.5 z 0 occ W !p2_a7_occ 1 beq !p2_a7_beq 0
      TCHZ_Peak_Type(, inst_U, , inst_V, , inst_W, , inst_Z, , inst_X, , inst_Y)
      prm p2_strain_l 0.274995 min 0.0001 max 5
      Strain_L(, p2_strain_l)
      prm p2_strain_g 0.039553 min 0.0001 max 5
      Strain_G(, p2_strain_g)
      prm p2_e0 = Voigt_FWHM_GL(p2_strain_g, p2_strain_l) .25 Pi/360; : 0
      LP_Factor(, lp_monochromator_angle)
      phase_out "drx33_rietveld__snapped_p2_peaks.txt" load out_record out_fmt out_eqn
      {
         " %.0f" = H;
         " %.0f" = K;
         " %.0f" = L;
         " %.0f" = M;
         " %.10g" = D_spacing;
         " %.10g" = 2 Rad Th;
         " %.10g" = I_no_scale_pks;
         " %.10g" = I_after_scale_pks;
         " %.10g" = Iobs_no_scale_pks;
         " %.10g" = A01;
         " %.10g" = B01;
         " %.10g" = A11;
         " %.10g\n" = B11;
      }

