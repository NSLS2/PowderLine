' Generated by PowderLine from a topas.rietveld recipe (topas engine schema 0.1.0, TOPAS 6)
iters 1000
do_errors
chi2_convergence_criteria 0.001

' instrument peak type: TCHZ_Peak_Type
prm inst_U 0.01037914 min = Max(-1, Val-.1); max = Min(2, Val+.1); del 1.0e-4
prm inst_V 0.0003329 min = Max(-1, Val-.1); max = Min(2, Val+.1); del 1.0e-4
prm inst_W 0.00063604 min = Max(-1, Val-.1); max = Min(2, Val+.1); del 1.0e-4
prm !inst_Z 0
prm inst_X 0.0001 min = Max(0.0001, Val-.1); max = Min(2, Val+.1); del 1.0e-4
prm inst_Y 0.0028143 min = Max(0.0001, Val-.1); max = Min(2, Val+.1); del 1.0e-4
prm !lps_pp 0.05
prm lps_mono 90 min 0.0000001 max 90.0

xdd "lab6_corrections__snapped.xye" xye_format
   x_calculation_step 0.001
   start_X 1.000355998
   finish_X 14.99760389
   Rs 217.5
   prm ze_th2_offset 0 min = Max(Val - 20 Yobs_dx_at(X1), -100 Yobs_dx_at(X1)); max = Min(Val + 20 Yobs_dx_at(X2), 100 Yobs_dx_at(X2)); del = .01 Yobs_dx_at(X1);
   ZE(, ze_th2_offset)
   prm ax_axial_length_mm 1 min 0.0001 max 50
   Simple_Axial_Model(, ax_axial_length_mm)
   capillary_diameter_mm !cap_diameter_mm 0.5
      capillary_u_cm_inv !cap_u_cm_inv 5
      capillary_parallel_beam
   lam ymin_on_ymax 0.0001 la !lam_la 1 lo !lam_lo 0.1665 lh !lam_lh 0.0001
   bkg bkg 20.643014 10.336598 1.2448956 -2.6654583 0.77835161 0.21475182
   prm oox 1 min 0.0001
   One_on_X(, oox)
   xo_Is
      xo bkpk1_xo 1.48 I bkpk1_I 270.25
      peak_type spvii h1 bkpk1_h1 6.5 h2 bkpk1_h2 6.5 m1 bkpk1_m1 2 m2 bkpk1_m2 2
   str
      phase_name "LaB6"
      space_group "pm-3m"
      scale p1_scale 2.6123606e-06
      a !p1_cell_a 4.15682   b = Get(a);   c = Get(a);   al 90   be 90   ga 90
      prm p1_volume = Get(cell_volume); : 0
      site La x 0 y 0 z 0 occ La !p1_a1_occ 1 beq !p1_a1_beq 0.6774496461
      site B x 0.5 y 0.5 z !p1_a2_z 0.2021 occ B !p1_a2_occ 1 beq !p1_a2_beq 0.7106115169
      TCHZ_Peak_Type(, inst_U, , inst_V, , inst_W, , inst_Z, , inst_X, , inst_Y)
      prm p1_cs_l 5000 min 0.3 max = Min(Val 2 + .3, 10000);
      CS_L(, p1_cs_l)
      prm p1_cs_g 9000 min 0.3 max = Min(Val 2 + .3, 10000);
      CS_G(, p1_cs_g)
      prm p1_lvol_ib = 1 / Voigt_Integral_Breadth_GL(1/p1_cs_g, 1/p1_cs_l); : 0
      LP_Factor_Synchrotron(, lps_pp, , lps_mono)
      phase_out "lab6_corrections__snapped_p1_peaks.txt" load out_record out_fmt out_eqn
      {
         " %.0f" = H;
         " %.0f" = K;
         " %.0f" = L;
         " %.0f" = M;
         " %.10g" = D_spacing;
         " %.10g" = 2 Rad Th;
         " %.10g" = I_no_scale_pks;
         " %.10g" = I_after_scale_pks;
         " %.10g" = Iobs_no_scale_pks;
         " %.10g" = A01;
         " %.10g" = B01;
         " %.10g" = A11;
         " %.10g\n" = B11;
      }

xdd_out "lab6_corrections__snapped_profile.txt" load out_record out_fmt out_eqn
{
   " %.10g" = X;
   " %.10g" = Yobs;
   " %.10g\n" = Ycalc;
}

out "lab6_corrections__snapped_results.csv"
   out_record out_fmt "parameter,value,esd\n"
   out_record out_eqn = Get(r_wp); out_fmt "r_wp,%.12g,\n"
   out_record out_eqn = Get(r_exp); out_fmt "r_exp,%.12g,\n"
   out_record out_eqn = Get(gof); out_fmt "gof,%.12g,\n"
   out_record out_eqn = Get(number_independent_parameters); out_fmt "number_independent_parameters,%.12g,\n"
   out_record out_eqn = inst_U; out_fmt "inst_U,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_V; out_fmt "inst_V,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_W; out_fmt "inst_W,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_X; out_fmt "inst_X,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_Y; out_fmt "inst_Y,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = lps_mono; out_fmt "lps_mono,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = ze_th2_offset; out_fmt "ze_th2_offset,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = ax_axial_length_mm; out_fmt "ax_axial_length_mm,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg0__; out_fmt "bkg_bkg0__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg1__; out_fmt "bkg_bkg1__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg2__; out_fmt "bkg_bkg2__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg3__; out_fmt "bkg_bkg3__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg4__; out_fmt "bkg_bkg4__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg5__; out_fmt "bkg_bkg5__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = oox; out_fmt "oox,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_xo; out_fmt "bkpk1_xo,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_I; out_fmt "bkpk1_I,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_h1; out_fmt "bkpk1_h1,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_h2; out_fmt "bkpk1_h2,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_m1; out_fmt "bkpk1_m1,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_m2; out_fmt "bkpk1_m2,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_scale; out_fmt "p1_scale,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_cs_l; out_fmt "p1_cs_l,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_cs_g; out_fmt "p1_cs_g,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_volume; out_fmt "p1_volume,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_lvol_ib; out_fmt "p1_lvol_ib,%.12g," out_fmt_err "%.12g\n"
