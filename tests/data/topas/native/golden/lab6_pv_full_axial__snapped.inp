' Generated by PowderLine from a topas.rietveld recipe (topas engine schema 0.1.0, TOPAS 6)
iters 1000
do_errors
chi2_convergence_criteria 0.001

' instrument peak type: PV_Peak_Type
prm inst_ha 0.01 min 0.0001 max = 2 Val + .1; del 0.001
prm inst_hb 0.001 min 0.0001 max = 2 Val + .1; del 0.001
prm inst_hc 0.001 min 0.0001 max = 2 Val + .1; del 0.001
prm inst_lora 0.5 min 0.0001 max 1 del 0.001
prm !inst_lorb 0.001
prm !inst_lorc 0.001
prm lp_monochromator_angle 89 min 0.0001 max 90

xdd "lab6_pv_full_axial__snapped.xye" xye_format
   x_calculation_step 0.001
   start_X 1.000355998
   finish_X 14.99760389
   Rp 217.5 Rs 217.5
   prm ze_th2_offset 0 min -0.05 max = Min(Val + 20 Yobs_dx_at(X2), 100 Yobs_dx_at(X2)); del = .01 Yobs_dx_at(X1);
   ZE(, ze_th2_offset)
   axial_conv
      filament_length !ax_filament_length 12
      sample_length !ax_sample_length 15
      receiving_slit_length !ax_receiving_slit_length 12
      primary_soller_angle !ax_primary_soller_angle 2.3
      secondary_soller_angle !ax_secondary_soller_angle 2.3
      axial_n_beta 20
   lam ymin_on_ymax 0.0001 la !lam_la 1 lo !lam_lo 0.1665 lh !lam_lh 0.0001
   bkg bkg 20.643014 10.336598 1.2448956 -2.6654583 0.77835161 0.21475182
   xo_Is
      xo bkpk1_xo 1.48 I bkpk1_I 270.25
      peak_type spv spv_h1 bkpk1_spv_h1 6.5 spv_h2 bkpk1_spv_h2 6.5 spv_l1 bkpk1_spv_l1 0.18 spv_l2 bkpk1_spv_l2 0.18
   str
      phase_name "LaB6"
      space_group "pm-3m"
      scale p1_scale 2.6123606e-06
      a !p1_cell_a 4.15682   b = Get(a);   c = Get(a);   al 90   be 90   ga 90
      prm p1_volume = Get(cell_volume); : 0
      site La x 0 y 0 z 0 occ La !p1_a1_occ 1 beq !p1_a1_beq 0.6774496461
      site B x 0.5 y 0.5 z !p1_a2_z 0.2021 occ B !p1_a2_occ 1 beq !p1_a2_beq 0.7106115169
      PV_Peak_Type(, inst_ha, , inst_hb, , inst_hc, , inst_lora, , inst_lorb, , inst_lorc)
      prm !p1_cs_l 10000
      CS_L(, p1_cs_l)
      prm p1_lvol_ib = 1 / (1.570796326795/p1_cs_l); : 0
      LP_Factor(, lp_monochromator_angle)
      phase_out "lab6_pv_full_axial__snapped_p1_peaks.txt" load out_record out_fmt out_eqn
      {
         " %.0f" = H;
         " %.0f" = K;
         " %.0f" = L;
         " %.0f" = M;
         " %.10g" = D_spacing;
         " %.10g" = 2 Rad Th;
         " %.10g" = I_no_scale_pks;
         " %.10g" = I_after_scale_pks;
         " %.10g" = Iobs_no_scale_pks;
         " %.10g" = A01;
         " %.10g" = B01;
         " %.10g" = A11;
         " %.10g\n" = B11;
      }

xdd_out "lab6_pv_full_axial__snapped_profile.txt" load out_record out_fmt out_eqn
{
   " %.10g" = X;
   " %.10g" = Yobs;
   " %.10g\n" = Ycalc;
}

out "lab6_pv_full_axial__snapped_results.csv"
   out_record out_fmt "parameter,value,esd\n"
   out_record out_eqn = Get(r_wp); out_fmt "r_wp,%.12g,\n"
   out_record out_eqn = Get(r_exp); out_fmt "r_exp,%.12g,\n"
   out_record out_eqn = Get(gof); out_fmt "gof,%.12g,\n"
   out_record out_eqn = Get(number_independent_parameters); out_fmt "number_independent_parameters,%.12g,\n"
   out_record out_eqn = inst_ha; out_fmt "inst_ha,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_hb; out_fmt "inst_hb,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_hc; out_fmt "inst_hc,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = inst_lora; out_fmt "inst_lora,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = lp_monochromator_angle; out_fmt "lp_monochromator_angle,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = ze_th2_offset; out_fmt "ze_th2_offset,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg0__; out_fmt "bkg_bkg0__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg1__; out_fmt "bkg_bkg1__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg2__; out_fmt "bkg_bkg2__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg3__; out_fmt "bkg_bkg3__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg4__; out_fmt "bkg_bkg4__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkg_bkg5__; out_fmt "bkg_bkg5__,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_xo; out_fmt "bkpk1_xo,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_I; out_fmt "bkpk1_I,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_spv_h1; out_fmt "bkpk1_spv_h1,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_spv_h2; out_fmt "bkpk1_spv_h2,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_spv_l1; out_fmt "bkpk1_spv_l1,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = bkpk1_spv_l2; out_fmt "bkpk1_spv_l2,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_scale; out_fmt "p1_scale,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_volume; out_fmt "p1_volume,%.12g," out_fmt_err "%.12g\n"
   out_record out_eqn = p1_lvol_ib; out_fmt "p1_lvol_ib,%.12g," out_fmt_err "%.12g\n"
