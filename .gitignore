# pixi environments
.pixi/

# Output directories
powderline_output_*/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Testing
.pytest_cache/

# Sphinx documentation builds
docs/_build/
docs/_templates/

# Configuration files with API keys (untracked)
.powderline_config.yaml
/config.yaml

# Private developer workspace: the PowderLine-devkit checkout (dev dossiers,
# agent context, private regression data). Must NEVER be committed here —
# the pre-commit guard in scripts/hooks/ enforces this too.
_dev/

# Claude Code settings
.claude/

# Pre-PR review scratch artifact (pasted into the PR by hand; not repo history)
/PR_BODY.md

# GSAS-II binary output files in examples (large; regenerated by running examples).
# Recursive globs so nested output dirs (e.g. output/gsasii/dummy.gpx) are covered.
examples/**/output/**/*.gpx
examples/**/output/**/*.bak*.gpx

# Stray Fortran scratch files (e.g. GSAS-II fort.NN reflection dumps)
fort.*

.vscode/*

# Maintainers' local probe scripts (never part of the package or the suite)
probes/
